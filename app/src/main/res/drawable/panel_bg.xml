<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#181818" android:endColor="#0b0b0b" android:angle="270" />
            <stroke android:width="1dp" android:color="#4a3a24" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#1affffff" />
        </shape>
    </item>
</layer-list>
