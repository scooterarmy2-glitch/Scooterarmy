<?xml version="1.0" encoding="utf-8"?>
<!-- Build #86: <bitmap> layer STRIPPED — the bitmap's 1600x1000 intrinsic
     size floored every panel at 1000px tall (the Build #79–#84 defect,
     now on Logs and the route dialog too). The brushed look comes from
     the code-built BrushedPanelDrawable (PANEL in Backgrounds.kt); this
     XML is the flat fallback. Border, radius and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1220" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#b300b4ff" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#2effffff" />
        </shape>
    </item>
</layer-list>
