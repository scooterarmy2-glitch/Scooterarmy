<?xml version="1.0" encoding="utf-8"?>
<!-- Build #85: the <bitmap> item is GONE. A <bitmap> layer reports the
     bitmap's intrinsic size (brushed_metal.jpg is 1600x1000) as the
     drawable's minimum, and Android floors wrap_content views at their
     background's minimum — that floored gpsInfo to 1000px tall and was
     the root cause of the broken main screen (contentCol 5171px on a
     2340px window, Build #84 overlay). The brushed-steel look now comes
     from the code-built BrushedPanelDrawable (Backgrounds.kt, zero
     minimum); this XML keeps the same base, tint, border and highlight
     as defence-in-depth. Border, radius and top highlight unchanged
     from Build #78. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1424" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#b300b4ff" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
        </shape>
    </item>
</layer-list>
