<?xml version="1.0" encoding="utf-8"?>
<!-- Settings SeekBar track (Build #86 glow, Build #87 blue): the filled
     part is a thin bright-blue line over a wider translucent-blue glow,
     on a dark grey unfilled track — the same glowing-line language as
     the dial's speed arc. Replaces the flat theme progress on all five
     Settings sliders. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#3a3a3a" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <shape android:shape="rectangle">
            <solid android:color="#3a3a3a" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item
                    android:height="6dp"
                    android:gravity="center_vertical">
                    <shape android:shape="rectangle">
                        <solid android:color="#3300b4ff" />
                    </shape>
                </item>
                <item
                    android:height="2dp"
                    android:gravity="center_vertical">
                    <shape android:shape="rectangle">
                        <solid android:color="#00b4ff" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
