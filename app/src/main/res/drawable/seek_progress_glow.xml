<?xml version="1.0" encoding="utf-8"?>
<!-- Settings SeekBar track (Build #86, LED glow): the filled part is a
     thin vivid-orange line over a wider translucent-orange glow, on a
     dark grey unfilled track — the same glowing-line language as the
     dial's speed arc. Replaces the flat theme progress on all five
     Settings sliders. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#3a3a3a" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <shape android:shape="rectangle">
            <solid android:color="#3a3a3a" />
            <size android:height="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item
                    android:height="6dp"
                    android:gravity="center_vertical">
                    <shape android:shape="rectangle">
                        <solid android:color="#33ff6a00" />
                    </shape>
                </item>
                <item
                    android:height="2dp"
                    android:gravity="center_vertical">
                    <shape android:shape="rectangle">
                        <solid android:color="#ff6a00" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
