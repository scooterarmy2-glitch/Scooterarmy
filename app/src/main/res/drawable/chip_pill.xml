<?xml version="1.0" encoding="utf-8"?>
<!-- Chip pill. Build #79: photographic brushed-metal photo under a
     translucent dark tint. Border, radius and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0e0e0e" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/brushed_metal" android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#4a4a4a" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
        </shape>
    </item>
</layer-list>
