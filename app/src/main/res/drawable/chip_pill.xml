<?xml version="1.0" encoding="utf-8"?>
<!-- Chip pill. Build #86: <bitmap> layer STRIPPED (the bitmap's
     1600x1000 intrinsic size floored every chip at 1000px tall — the
     Build #79–#84 defect, now on the live map too). The brushed look
     comes from the code-built BrushedPanelDrawable (CHIP_PLAIN in
     Backgrounds.kt); this XML is the flat fallback. Border is now
     steel blue #5a7aa8 (Build #86 secondary accent, echoing the map's
     blue route) — was grey #4a4a4a. Radius and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0e0e0e" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#5a7aa8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
        </shape>
    </item>
</layer-list>
