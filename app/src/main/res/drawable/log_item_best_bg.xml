<?xml version="1.0" encoding="utf-8"?>
<!-- Best-run log row (web .hist-item.best: amber-tinted border + top edge). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#141414" android:endColor="#0d0d0d" android:angle="270" />
            <stroke android:width="1dp" android:color="#4a3200" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#664500" />
        </shape>
    </item>
</layer-list>
