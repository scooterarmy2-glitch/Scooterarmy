<?xml version="1.0" encoding="utf-8"?>
<!-- Build #86: <bitmap> layer STRIPPED — the bitmap's 1600x1000 intrinsic
     size floored every log row at 1000px tall (the Build #79–#84
     defect). The brushed look comes from the code-built
     BrushedPanelDrawable (LOG_ITEM in Backgrounds.kt); this XML is the
     flat fallback. Border, radius and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0d0c0a" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#3d3d3d" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#1affffff" />
        </shape>
    </item>
</layer-list>
