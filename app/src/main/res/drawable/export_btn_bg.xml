<?xml version="1.0" encoding="utf-8"?>
<!-- Bordered chip button (CSV / GPX export) — matches the web .export-btn.
     Build #78: glassy gradient instead of a transparent fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#101a2c" android:endColor="#0a1220" android:angle="270" />
            <stroke android:width="1dp" android:color="#b300b4ff" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
        </shape>
    </item>
</layer-list>
