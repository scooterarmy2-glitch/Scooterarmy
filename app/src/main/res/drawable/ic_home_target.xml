<?xml version="1.0" encoding="utf-8"?>
<!-- Crosshair / target mark for the live-map home button (Build #88):
     a drawn vector, not a font glyph, so it can never render as a
     blank box. White ring + LED-blue centre dot + four ticks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,5 A7,7 0 1,0 12,19 A7,7 0 1,0 12,5 Z"
        android:fillColor="#00000000"
        android:strokeColor="#ffffff"
        android:strokeWidth="1.8" />
    <path
        android:pathData="M12,10.5 A1.5,1.5 0 1,0 12,13.5 A1.5,1.5 0 1,0 12,10.5 Z"
        android:fillColor="#00b4ff" />
    <path
        android:pathData="M12,1 L12,4 M12,20 L12,23 M1,12 L4,12 M20,12 L23,12"
        android:strokeColor="#ffffff"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
</vector>
