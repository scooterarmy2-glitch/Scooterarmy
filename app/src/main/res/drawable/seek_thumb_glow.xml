<?xml version="1.0" encoding="utf-8"?>
<!-- Settings SeekBar thumb (Build #86 glow, Build #87 blue): a glowing
     blue dot — a soft radial halo behind a solid bright-blue core, the
     same LED language as the dial's needle and arc. Replaces the flat
     theme thumb on all five Settings sliders. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="14dp"
                android:startColor="#6600b4ff"
                android:endColor="#0000b4ff" />
        </shape>
    </item>
    <item
        android:width="14dp"
        android:height="14dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00b4ff" />
        </shape>
    </item>
</layer-list>
