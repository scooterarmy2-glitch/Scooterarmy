<?xml version="1.0" encoding="utf-8"?>
<!-- App background: warm ember glow rising from the bottom + dark vignette at top.
     Matches the old web app's body background (radial ember gradients). The
     diamond-plate texture is tiled over this at runtime (MainActivity). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080808" />
        </shape>
    </item>
    <!-- Ember glow, bottom center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="1.0"
                android:gradientRadius="420dp"
                android:startColor="#38c83c00"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Hotter orange core, bottom center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="1.0"
                android:gradientRadius="300dp"
                android:startColor="#1aff6400"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Dark vignette at the top -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="500dp"
                android:startColor="#b3000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
