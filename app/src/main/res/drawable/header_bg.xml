<?xml version="1.0" encoding="utf-8"?>
<!-- Build #86: <bitmap> layer STRIPPED — the bitmap's 1600x1000 intrinsic
     size floored the Logs header at 1000px tall (the Build #79–#84
     defect). The brushed look comes from the code-built
     BrushedPanelDrawable (HEADER in Backgrounds.kt); this XML is the
     flat fallback. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1220" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
        </shape>
    </item>
</layer-list>
