<?xml version="1.0" encoding="utf-8"?>
<!-- Build #79: photographic brushed-metal photo under a translucent dark
     tint, replacing the flat gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f0d08" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/brushed_metal" android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
        </shape>
    </item>
</layer-list>
