<?xml version="1.0" encoding="utf-8"?>
<!-- Live session strip: green-tinted, kept green so "live" still reads.
     Build #85: the <bitmap> item is GONE. A <bitmap> layer reports the
     bitmap's intrinsic size (brushed_metal.jpg is 1600x1000) as the
     drawable's minimum, and Android floors wrap_content views at their
     background's minimum. The brushed-steel look now comes from the
     code-built BrushedPanelDrawable (Backgrounds.kt, zero minimum);
     this XML keeps the same base, tint and border as defence-in-depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#001008" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#6600220f" android:endColor="#80001008" android:angle="270" />
            <stroke android:width="1dp" android:color="#005533" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
