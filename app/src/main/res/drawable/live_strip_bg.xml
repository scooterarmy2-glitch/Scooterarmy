<?xml version="1.0" encoding="utf-8"?>
<!-- Live session strip: green-tinted, kept green so "live" still reads.
     Build #79: photographic brushed-metal photo under a translucent
     green-tinted dark overlay, replacing the flat green gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#001008" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/brushed_metal" android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#6600220f" android:endColor="#80001008" android:angle="270" />
            <stroke android:width="1dp" android:color="#005533" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
