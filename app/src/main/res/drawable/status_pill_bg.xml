<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom status pill (live map): dark pill with an LED-orange edge (Build #81).
     Build #79: photographic brushed-metal photo under a translucent dark
     tint. Border, radius and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#100d08" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/brushed_metal" android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#ff6a00" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
        </shape>
    </item>
</layer-list>
