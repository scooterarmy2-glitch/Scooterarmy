<?xml version="1.0" encoding="utf-8"?>
<!-- Speed chip pill (live map): LED-orange border, the active chip (Build #81).
     Build #86: <bitmap> layer STRIPPED (same 1000px floor defect).
     Brushed look comes from the code-built BrushedPanelDrawable
     (CHIP_AMBER in Backgrounds.kt); this XML is the flat fallback.
     Border, radius and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#120e07" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#ff6a00" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
        </shape>
    </item>
</layer-list>
