<?xml version="1.0" encoding="utf-8"?>
<!-- Build #86: <bitmap> layer STRIPPED — the bitmap's 1600x1000 intrinsic
     size floored every dialog at 1000px tall (the Build #79–#84
     defect, now on the route + log-detail dialogs). The brushed look
     comes from the code-built BrushedPanelDrawable (DIALOG in
     Backgrounds.kt); this XML is the flat fallback. LED-blue top
     strip, border and radius unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1424" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#00b4ff" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="0dp" android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#00b4ff" />
        </shape>
    </item>
</layer-list>
