<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1a1a1a" android:endColor="#0d0d0d" android:angle="270" />
            <stroke android:width="1dp" android:color="#444444" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="0dp" android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#d99a4e" />
        </shape>
    </item>
</layer-list>
