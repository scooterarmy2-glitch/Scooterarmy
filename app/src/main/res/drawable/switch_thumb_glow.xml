<?xml version="1.0" encoding="utf-8"?>
<!-- Settings switch thumb (Build #86, LED glow): when ON the thumb is a
     glowing vivid-orange dot (soft halo + solid core); when OFF it is a
     plain dim-grey dot. The track stays the theme tint. Replaces the flat
     theme thumb on the spike-guard, alert-beep and diagnostics switches. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list
            android:width="28dp"
            android:height="28dp">
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="radial"
                        android:gradientRadius="14dp"
                        android:startColor="#66ff6a00"
                        android:endColor="#00ff6a00" />
                </shape>
            </item>
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#ff6a00" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list
            android:width="28dp"
            android:height="28dp">
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="#9e9e9e" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
