<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen info row: dark background with a 1px #1a1a1a top border (web .fs-info-row).
     Build #85: the <bitmap> item is GONE. A <bitmap> layer reports the
     bitmap's intrinsic size (brushed_metal.jpg is 1600x1000) as the
     drawable's minimum, and Android floors wrap_content views at their
     background's minimum. The brushed-steel look now comes from the
     code-built BrushedPanelDrawable (Backgrounds.kt, zero minimum);
     this XML keeps the same base, tint and top border as
     defence-in-depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1220" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#1a1a1a" />
        </shape>
    </item>
</layer-list>
