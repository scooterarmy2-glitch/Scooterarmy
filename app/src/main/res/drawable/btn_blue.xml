<?xml version="1.0" encoding="utf-8"?>
<!-- Export GPX button (route dialog, look-pro): blue, matches the route line. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1e88e5" android:endColor="#1565c0" android:angle="270" />
            <stroke android:width="1dp" android:color="#1565c0" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#40ffffff" />
        </shape>
    </item>
</layer-list>
