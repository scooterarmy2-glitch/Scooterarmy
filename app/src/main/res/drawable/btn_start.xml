<?xml version="1.0" encoding="utf-8"?>
<!-- START RIDE button (Build #86 plain rectangle; Build #87 blue;
     Build #88 solid black fill; Build #89 soft rounded corners):
     4dp corners — the same radius as the RIDE/TIMED panels and the
     status strip (PanelVariant.PANEL / GPS, radiusDp 4f), so the
     button matches the other boxes instead of sitting square inside
     them. Solid #080808 fill, bright LED-blue edge, bright top edge
     kept (same layer-list pattern as btn_primary). Not chamfered —
     Casey Nov 23 superseded the #86 square call: rounded like the
     other boxes. Shape drawable (dp-based), so the radius is exact
     at any screen size; the old vector stretched non-uniformly. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080808" />
            <stroke android:width="2dp" android:color="#00b4ff" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Bright top edge so the button reads as lit metal. Inset 4dp
         each side so the strip never pokes past the rounded corners. -->
    <item android:left="4dp" android:right="4dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#59ffffff" />
        </shape>
    </item>
</layer-list>
