<?xml version="1.0" encoding="utf-8"?>
<!-- START RIDE button (Build #86 plain rectangle; Build #87 blue):
     square corners, dark glass fill with a bright LED-blue edge —
     a lit button, not a solid pastel fill. The bright top edge is kept,
     full width now that the corners are square. Vector so it scales with
     the button. Works on API 21+; minSdk is 26. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="24">
    <path
        android:pathData="M0,0 L100,0 L100,24 L0,24 Z"
        android:strokeColor="#00b4ff"
        android:strokeWidth="2">
        <gradient
            android:type="linear"
            android:startX="0"
            android:startY="0"
            android:endX="0"
            android:endY="24"
            android:startColor="#2a2a2a"
            android:endColor="#141414" />
    </path>
    <!-- Bright top edge so the button reads as lit metal. -->
    <path
        android:pathData="M0,0 L100,0 L100,2 L0,2 Z"
        android:fillColor="#59ffffff" />
</vector>
