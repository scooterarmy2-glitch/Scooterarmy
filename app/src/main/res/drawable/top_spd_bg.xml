<?xml version="1.0" encoding="utf-8"?>
<!-- TOP SPEED chip (Build #78): glassy amber-edged chip — brighter border
     and a top inner highlight so it reads as lit glass, not a flat box.
     Build #79: photographic brushed-metal photo under a translucent dark
     tint. Amber border and top highlight unchanged. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#120e07" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/brushed_metal" android:gravity="center" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#80000000" android:endColor="#b3000000" android:angle="270" />
            <stroke android:width="1dp" android:color="#b3d99a4e" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="4dp" android:right="4dp" android:top="0dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#2effffff" />
        </shape>
    </item>
</layer-list>
