<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/log_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rideName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace" android:tag="font_share_tech_mono"
            android:textColor="#dddddd"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rideMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace" android:tag="font_share_tech_mono"
            android:textColor="#888888"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rideTopSpd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif" android:tag="font_orbitron_900"
            android:textColor="@color/amber"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace" android:tag="font_share_tech_mono"
            android:text="TOP SPEED"
            android:textColor="#666666"
            android:textSize="8sp" />
    </LinearLayout>

    <Button
        android:id="@+id/rideDel"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="2dp"
        android:text="✕"
        android:textColor="#666666"
        android:textSize="14sp" />
</LinearLayout>
