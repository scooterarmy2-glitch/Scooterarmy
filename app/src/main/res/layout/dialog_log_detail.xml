<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/logTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif" android:tag="font_orbitron_700"
        android:textColor="#cccccc"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/logBig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif" android:tag="font_orbitron_900"
        android:textColor="#ffffff"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/logBigLbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif" android:tag="font_orbitron_700"
        android:textColor="@color/amber"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/logRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

    <Button
        android:id="@+id/viewRouteBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#1e1e1e"
        android:fontFamily="sans-serif" android:tag="font_orbitron_700"
        android:text="VIEW ROUTE"
        android:textColor="#ffffff"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/logClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="#1e1e1e"
        android:fontFamily="sans-serif" android:tag="font_orbitron_700"
        android:text="CLOSE"
        android:textColor="#ffffff"
        android:textSize="13sp" />
</LinearLayout>
