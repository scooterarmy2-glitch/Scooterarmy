<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_bg"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:paddingLeft="18dp"
            android:paddingTop="12dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/settings_btn_bg"
                android:contentDescription="Back"
                android:fontFamily="@font/orbitron_900"
                android:gravity="center"
                android:text="‹"
                android:textColor="#cccccc"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_900"
                    android:letterSpacing="0.06"
                    android:text="#"
                    android:textColor="#00b4ff"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_900"
                    android:letterSpacing="0.06"
                    android:text="SAMO GPS"
                    android:textColor="@color/chrome"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/settings_btn_bg"
                android:contentDescription="Settings"
                android:fontFamily="@font/share_tech_mono"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#cccccc"
                android:textSize="20sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/header_divider" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/innerCol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="60dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_700"
                    android:gravity="center_horizontal"
                    android:letterSpacing="0.3"
                    android:text="LOGS"
                    android:textColor="#bbbbbb"
                    android:textSize="12sp" />

                <!-- Build #90 (Casey Nov 23): the totals/summary box is
                     GONE — no TOTAL DISTANCE / TOTAL MOVING TIME card.
                     The screen starts with the RIDES section. -->

                <!-- RIDES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/orbitron_700"
                            android:letterSpacing="0.3"
                            android:text="RIDES"
                            android:textColor="#bbbbbb"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/exportRidesCsv"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/export_btn_bg"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="CSV"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/exportRidesGpx"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/export_btn_bg"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="GPX"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/clearSessions"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="3dp"
                            android:text="CLEAR ALL"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ridesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/noRides"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center_horizontal"
                        android:letterSpacing="0.2"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="— no rides recorded —"
                        android:textColor="#aaaaaa"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- TIMED RUNS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/orbitron_700"
                            android:letterSpacing="0.3"
                            android:text="TIMED RUNS"
                            android:textColor="#bbbbbb"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/exportRunsCsv"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/export_btn_bg"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="CSV"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/clearHistory"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="3dp"
                            android:text="CLEAR ALL"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/runsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/noRuns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center_horizontal"
                        android:letterSpacing="0.2"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="— no runs recorded —"
                        android:textColor="#aaaaaa"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
