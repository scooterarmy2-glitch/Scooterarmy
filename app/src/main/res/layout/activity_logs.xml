<?xml version="1.0" encoding="utf-8"?>
<!-- Trips page — fresh from the Trips frame (6591_28_o9mx.jpg):
     "Every trip saved on your phone." + summary card (distance / moving
     time / trip count) + ride list + timed-run list + bottom tabs.
     Same LogStore, same exports, same detail dialogs as main. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/innerCol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="14dp"
                android:paddingBottom="60dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_900"
                    android:gravity="center_horizontal"
                    android:letterSpacing="0.04"
                    android:text="Every trip saved on your phone."
                    android:textColor="#ffffff"
                    android:textSize="16sp" />

                <!-- SUMMARY CARD -->
                <LinearLayout
                    android:id="@+id/summaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/panel_bg"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="-14dp"
                        android:layout_marginBottom="11dp"
                        android:background="@drawable/accent_top" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/orbitron_700"
                            android:letterSpacing="0.2"
                            android:text="TOTAL DISTANCE"
                            android:textColor="#cccccc"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/sumDist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/orbitron_900"
                            android:text="0.00 mi"
                            android:textColor="@color/chrome"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/sumDistSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/share_tech_mono"
                            android:text="0 rides"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#252525" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/orbitron_700"
                            android:letterSpacing="0.2"
                            android:text="TOTAL MOVING TIME"
                            android:textColor="#cccccc"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/sumTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/orbitron_900"
                            android:text="0:00"
                            android:textColor="@color/chrome"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/sumTimeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/share_tech_mono"
                            android:text="0 runs"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />
                    </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sumTrips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center_horizontal"
                        android:text="0 trips"
                        android:textColor="#aaaaaa"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- RIDES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/orbitron_700"
                            android:letterSpacing="0.3"
                            android:text="RIDES"
                            android:textColor="#bbbbbb"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/exportRidesCsv"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/export_btn_bg"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="CSV"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/exportRidesGpx"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/export_btn_bg"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="GPX"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/clearSessions"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="3dp"
                            android:text="CLEAR ALL"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ridesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/noRides"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center_horizontal"
                        android:letterSpacing="0.2"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="— no rides recorded —"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- TIMED RUNS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/orbitron_700"
                            android:letterSpacing="0.3"
                            android:text="TIMED RUNS"
                            android:textColor="#bbbbbb"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/exportRunsCsv"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/export_btn_bg"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="CSV"
                            android:textColor="#aaaaaa"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/clearHistory"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.1"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:padding="3dp"
                            android:text="CLEAR ALL"
                            android:textColor="#888888"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/runsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/noRuns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center_horizontal"
                        android:letterSpacing="0.2"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="— no runs recorded —"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- BOTTOM TABS — Speed / Trips / Settings. -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0d0d0d"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/tabSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_speed" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:text="Speed"
                android:textColor="#bbbbbb"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTrips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_active_bg"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_trips" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:text="Trips"
                android:textColor="#ffffff"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_settings" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:text="Settings"
                android:textColor="#bbbbbb"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
