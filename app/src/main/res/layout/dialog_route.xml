<?xml version="1.0" encoding="utf-8"?>
<!-- ROUTE dialog (look-pro, from the approved map render): dark Esri map,
     bright blue route, green Start / red End pins, one stats row
     (distance / time / top speed, the ride's real numbers), Export GPX /
     Export CSV buttons. NO headline — Casey explicitly cut the
     "GPX + CSV EXPORT. YOURS TO KEEP." line. Build #90: FULL SCREEN
     (root match_parent, map 0dp + weight 1 — the map takes all remaining
     space) and the "Export Data" title row is GONE (Casey Nov 23) — the
     export buttons stay exactly as they are. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/routeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_700"
        android:text="ROUTE"
        android:letterSpacing="0.2"
        android:textColor="#cccccc"
        android:textSize="13sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/routeMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/map_frame_bg"
        android:clipToOutline="true" />

    <!-- Stats row: distance / time / top speed, each once.
         Build #86: android:id so RouteMapDialog can set the code-built
         PANEL background (zero minimum) — the old panel_bg XML floored
         this row at 1000px, pushing the Export buttons off-screen. -->
    <LinearLayout
        android:id="@+id/routeStatsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_bg"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/statDistVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="—"
                android:textColor="#ffffff"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:letterSpacing="0.2"
                android:text="DISTANCE"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/statTimeVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="—"
                android:textColor="#ffffff"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:letterSpacing="0.2"
                android:text="TIME"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/statTopVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="—"
                android:textColor="#ffffff"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:letterSpacing="0.2"
                android:text="TOP SPEED"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Build #90: the "Export Data" title row is GONE (Casey Nov 23) —
         no title, no "Share your ride data easily" subtitle. The export
         buttons below stay exactly as they are. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/routeExportGpx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_blue"
            android:fontFamily="@font/orbitron_900"
            android:text="Export GPX"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/routeExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_blue"
            android:fontFamily="@font/orbitron_900"
            android:text="Export CSV"
            android:textColor="#ffffff"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/routeClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/dialog_btn_bg"
        android:fontFamily="@font/orbitron_700"
        android:letterSpacing="0.25"
        android:text="CLOSE"
        android:textColor="#ffffff"
        android:textSize="13sp" />
</LinearLayout>
