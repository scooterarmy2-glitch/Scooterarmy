<?xml version="1.0" encoding="utf-8"?>
<!-- ROUTE page — fresh from the map mockup
     (media-generation-gps-map-screen-mockup-0-58dba21d…): dark map,
     bright blue route, green Start / red End pins, trip summary strip
     overlaid at the map's bottom (date/dist | Start/duration | top),
     then "GPX + CSV EXPORT. YOURS TO KEEP." + Export Data card with
     Export GPX (blue) / Export CSV (green). Values are the ride's real
     numbers, mph, not the mockup's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/routeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_700"
        android:letterSpacing="0.2"
        android:text="ROUTE"
        android:textColor="#cccccc"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="12dp">

        <org.osmdroid.views.MapView
            android:id="@+id/routeMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/map_frame_bg"
            android:clipToOutline="true" />

        <!-- Trip summary strip overlaid at the map's bottom (map mockup):
             date + distance | Start + duration | top speed, each once. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#cc111111"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/stripDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:text="—"
                    android:textColor="#cccccc"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/stripDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_700"
                    android:text="—"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:text="Start"
                    android:textColor="#cccccc"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/stripDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/orbitron_700"
                    android:text="—"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/stripTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/orbitron_700"
                    android:text="—"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/routeExportLbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/orbitron_900"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="GPX + CSV EXPORT. YOURS TO KEEP."
        android:textColor="#ffffff"
        android:textSize="15sp" />

    <!-- Export Data card (map mockup): blue check + title + subline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exportCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/btn_blue"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="✓"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="Export Data"
                android:textColor="#ffffff"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:text="Share your ride data easily"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/routeExportGpx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_blue"
            android:fontFamily="@font/orbitron_900"
            android:text="Export GPX"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/routeExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_green"
            android:fontFamily="@font/orbitron_900"
            android:text="Export CSV"
            android:textColor="#ffffff"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/routeClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/dialog_btn_bg"
        android:fontFamily="@font/orbitron_700"
        android:letterSpacing="0.25"
        android:text="CLOSE"
        android:textColor="#ffffff"
        android:textSize="13sp" />
</LinearLayout>
