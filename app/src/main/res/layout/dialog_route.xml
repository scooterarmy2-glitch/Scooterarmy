<?xml version="1.0" encoding="utf-8"?>
<!-- ROUTE dialog (look-pro, from the approved map render): dark Esri map,
     bright blue route, green Start / red End pins, one stats row
     (distance / time / top speed, the ride's real numbers), Export Data
     card with blue Export GPX / green Export CSV. NO headline — Casey
     explicitly cut the "GPX + CSV EXPORT. YOURS TO KEEP." line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/routeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_700"
        android:text="ROUTE"
        android:letterSpacing="0.2"
        android:textColor="#cccccc"
        android:textSize="13sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/routeMap"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/map_frame_bg"
        android:clipToOutline="true" />

    <!-- Stats row: distance / time / top speed, each once.
         Build #86: android:id so RouteMapDialog can set the code-built
         PANEL background (zero minimum) — the old panel_bg XML floored
         this row at 1000px, pushing the Export buttons off-screen. -->
    <LinearLayout
        android:id="@+id/routeStatsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_bg"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/statDistVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="—"
                android:textColor="#ffffff"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:letterSpacing="0.2"
                android:text="DISTANCE"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/statTimeVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="—"
                android:textColor="#ffffff"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:letterSpacing="0.2"
                android:text="TIME"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/statTopVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="—"
                android:textColor="#ffffff"
                android:textSize="20sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/orbitron_700"
                android:letterSpacing="0.2"
                android:text="TOP SPEED"
                android:textColor="#888888"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Export Data card (map render): blue check + title + subline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exportCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/btn_blue"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="✓"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/orbitron_900"
                android:text="Export Data"
                android:textColor="#ffffff"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:text="Share your ride data easily"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/routeExportGpx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_blue"
            android:fontFamily="@font/orbitron_900"
            android:text="Export GPX"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/routeExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_blue"
            android:fontFamily="@font/orbitron_900"
            android:text="Export CSV"
            android:textColor="#ffffff"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/routeClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/dialog_btn_bg"
        android:fontFamily="@font/orbitron_700"
        android:letterSpacing="0.25"
        android:text="CLOSE"
        android:textColor="#ffffff"
        android:textSize="13sp" />
</LinearLayout>
